{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app.relayforge.ir/schemas/internal_events.schema.json",
  "title": "RelayForge Multi-Tenant Internal Domain Event Envelope v2.0",
  "description": "100% synchronized with 06_MODULE_CONTRACTS.md and app.domain_outbox.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "tenant_id",
    "workspace_id",
    "event_type",
    "schema_version",
    "correlation_id",
    "occurred_at",
    "producer_module",
    "payload"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "workspace_id": { "type": "string", "format": "uuid" },
    "event_type": {
      "type": "string",
      "enum": [
        "tenant.provisioned",
        "tenant.crypto_shredded",
        "workspace.initialized",
        "workspace.switched",
        "workspace.migration.completed",
        "ops.disk_space.low",
        "security.secret.stored",
        "security.secret.revoked",
        "security.consent.updated",
        "security.unauthorized_blocked",
        "source.status.changed",
        "export.presigned.issued",
        "export.stream_parsed.completed",
        "destination.status.changed",
        "content.batch.fetched",
        "connector.rate_limit.cooldown",
        "content.item.ingested",
        "content.source.edited",
        "content.source.deleted",
        "channel.samples.collected",
        "channel.analysis.completed",
        "style.revision.created",
        "brand.identity.updated",
        "learning.rule.proposed",
        "ai.catalog.refreshed",
        "budget.plan_quota.updated",
        "budget.threshold.reached",
        "ai.quota.exhausted",
        "ai.execution.finished",
        "generation.candidate.created",
        "generation.fact_discrepancy.detected",
        "media.asset.stored",
        "media.job.progress",
        "media.job.completed",
        "media.job.failed",
        "media.orphan.cleaned",
        "route.dry_run.completed",
        "draft.saved",
        "draft.approved.human",
        "publication.version.frozen",
        "delivery.sent",
        "delivery.failed",
        "delivery.marked_uncertain",
        "delivery.reconciled",
        "ops.emergency_stop.activated",
        "backup.created",
        "backup.restored.safe_mode",
        "ops.alert.raised",
        "ops.reset.completed"
      ]
    },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "correlation_id": { "type": "string", "minLength": 8, "maxLength": 64 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "producer_module": {
      "type": "string",
      "enum": ["M01", "M02", "M03", "M04", "M05", "M06", "M07", "M08", "M09", "M10"]
    },
    "payload": {
      "type": "object"
    }
  }
}
